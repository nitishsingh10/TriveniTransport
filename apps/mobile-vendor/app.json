{
  "expo": {
    "name": "Triveni P&M Vendor",
    "slug": "triveni-pnm-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "trivenipnmvendor",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trivenitransports.pnmvendor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1F37",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.trivenitransports.pnmvendor",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-document-picker", "expo-status-bar"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
