# ─── Runtime ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ─── Database ─────────────────────────────────────────────────────
# PostgreSQL — use Supabase or Neon for managed hosting
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/triveni_transports?schema=public

# ─── Redis ────────────────────────────────────────────────────────
# IMPORTANT: Upstash Redis must have keyspace notifications enabled
# Configure in Upstash dashboard: notify-keyspace-events = KEA
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here-different-from-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP ──────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# ─── Razorpay ─────────────────────────────────────────────────────
# Test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
ADVANCE_PAYMENT_PERCENT=20

# ─── Google Maps ──────────────────────────────────────────────────
# Enable: Geocoding API + Distance Matrix API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── MSG91 (WhatsApp + SMS) ────────────────────────────────────────
# https://msg91.com
MSG91_API_KEY=your_msg91_api_key
MSG91_SENDER_ID=TRIVNI
MSG91_WHATSAPP_NUMBER=917XXXXXXXXX

# ─── Expo Push ────────────────────────────────────────────────────
# https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=your_expo_access_token

# ─── Resend (Email) ───────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=bookings@trivenipackers.com

# ─── Cloudinary (Photos + Invoices) ──────────────────────────────
# Phase 1b — not required for Phase 1a launch
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Admin ────────────────────────────────────────────────────────
# The phone number of the initial admin user (seeded to DB)
ADMIN_PHONE=9XXXXXXXXX
