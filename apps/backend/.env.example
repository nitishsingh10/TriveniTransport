# Triveni Transports Backend — Environment Variables Template
# Copy this file to .env and fill in real values

NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081,http://localhost:8082

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (Upstash)
REDIS_URL=rediss://default:token@host:6379

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
ADVANCE_PAYMENT_PERCENT=20

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# SMS & WhatsApp (MSG91)
MSG91_API_KEY=your_msg91_api_key
MSG91_SENDER_ID=TRIVNI
MSG91_WHATSAPP_NUMBER=919876543210

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your_expo_access_token

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=bookings@trivenitransports.in

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin
ADMIN_PHONE=9999999999
