{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "paths": {
      "@triveni/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@triveni/shared-validation": ["../../packages/shared-validation/src/index.ts"],
      "@triveni/pricing-preview": ["../../packages/pricing-preview/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma"]
}
