{
  "name": "@triveni/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Triveni Transports — Express/TypeScript API server",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@triveni/shared-types": "workspace:*",
    "@triveni/shared-validation": "workspace:*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.56.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.4",
    "razorpay": "^2.9.6",
    "expo-server-sdk": "^3.14.0",
    "pdfkit": "^0.17.0",
    "handlebars": "^4.7.8",
    "axios": "^1.9.0",
    "resend": "^4.5.2",
    "rate-limiter-flexible": "^5.0.5",
    "uuid": "^11.1.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@triveni/config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.29",
    "@types/uuid": "^10.0.0",
    "@types/pdfkit": "^0.13.9",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
