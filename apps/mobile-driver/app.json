{
  "expo": {
    "name": "Triveni Driver",
    "slug": "triveni-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "trivenidriver",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trivenitransports.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Triveni Driver uses your location to broadcast live telemetry to operations and customers while fulfilling active moves.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Triveni Driver uses your background location to broadcast transit progress while duty is active."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1F37",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.trivenitransports.driver",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1F37",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
