{
  "expo": {
    "name": "Triveni Driver",
    "slug": "triveni-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "trivenidriver",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0D1F37",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trivenitransports.driver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1F37",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.trivenitransports.driver",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1F37",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
