{
  "expo": {
    "name": "Triveni Transports",
    "slug": "triveni-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "triveni",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#00000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trivenitransports.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Triveni Transports uses your location to automatically set your moving pickup address."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1F37",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.trivenitransports.customer",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1F37",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cdf8d6f-0ed4-494f-a3e4-9f16424cc44f"
      }
    }
  }
}
