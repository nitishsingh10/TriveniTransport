{
  "name": "triveni-transports",
  "version": "1.0.0",
  "private": true,
  "description": "Triveni Transports Packers & Movers — Digital Platform Monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @triveni/web dev",
    "dev:mobile": "pnpm --filter @triveni/mobile-customer start",
    "dev:driver": "pnpm --filter @triveni/mobile-driver start",
    "dev:backend": "pnpm --filter @triveni/backend dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @triveni/web build",
    "build:backend": "pnpm --filter @triveni/backend build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "pnpm --filter @triveni/web typecheck",
    "typecheck:mobile": "pnpm --filter @triveni/mobile-customer typecheck",
    "typecheck:driver": "pnpm --filter @triveni/mobile-driver typecheck",
    "typecheck:backend": "pnpm --filter @triveni/backend typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.7.3",
    "@types/node": "^22.15.29",
    "prettier": "^3.5.3",
    "eslint": "^9.29.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
